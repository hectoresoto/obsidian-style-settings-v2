{
  "name": "obsidian-style-settings",
  "version": "2.0.0",
  "description": "Offers controls for adjusting theme, plugin, and CSS snippet styles.",
  "main": "main.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "tsc --noemit",
    "dev": "node scripts/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs production",
    "test": "vitest run --config tests/vitest.config.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "lint": "eslint ./src --max-warnings=0",
    "lint:fix": "eslint ./src --fix --max-warnings=0",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "pnpm run prettier && pnpm run lint:fix",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "hectoresoto",
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "useTabs": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "16.11.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "obsidian": "latest",
    "prettier": "3.0.2",
    "tslib": "2.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@simonwep/pickr": "https://github.com/nothingislost/pickr/archive/a17739f7aa1871b44da778cbb79ae76dae77d839.tar.gz",
    "@types/chroma-js": "^2.1.3",
    "chroma-js": "^2.1.2",
    "detect-indent": "^7.0.0",
    "dotenv": "^10.0.0",
    "fuzzysort": "^2.0.4",
    "js-yaml": "^5.5.0"
  }
}
